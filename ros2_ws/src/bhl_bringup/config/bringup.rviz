Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: 바닥 격자
      Cell Size: 0.25
      Plane Cell Count: 20
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: 로봇 (robot_state_publisher, 측정 자세)
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF 프레임
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.3
      Frame Timeout: 15
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 0
        Y: 0.0
        Z: 0.6
      Pitch: 0.35
      Yaw: 2.2
      Name: Current View
      Target Frame: world
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
  Displays:
    collapsed: false
