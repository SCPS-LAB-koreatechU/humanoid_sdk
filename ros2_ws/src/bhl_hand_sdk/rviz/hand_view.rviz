Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: 격자
      Cell Size: 0.05
      Plane Cell Count: 10
      Reference Frame: hand_view/base_link
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /hand_view/robot_description
      TF Prefix: hand_view
      Enabled: true
      Name: DexHand V2 (명령 자세 추정, 측정 아님)
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF 프레임
      Show Names: false
      Marker Scale: 0.05
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: hand_view/base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.45
      Focal Point:
        X: 0
        Y: 0
        Z: 0.08
      Pitch: 0.3
      Yaw: 0.8
      Name: Current View
      Target Frame: hand_view/base_link
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1000
  Displays:
    collapsed: false
